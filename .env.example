# LLM provider (Phase 5 - explanation generation)
LLM_PROVIDER=anthropic
LLM_API_KEY=

# Sarvam AI (optional): faster Indian-language translation + natural TTS.
# When set, used first; NLLB and gTTS remain as fallbacks. Text is sent to Sarvam.
SARVAM_API_KEY=

# Translation provider (Phase 7 - i18n)
TRANSLATION_PROVIDER=google
TRANSLATION_API_KEY=
